<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin | Configurações</title>
    <style>
        body { margin:0; font-family:Inter, Arial, sans-serif; background:#090909; color:#F4F4F4; }
        header { display:flex; justify-content:space-between; align-items:center; padding:24px 40px; background:rgba(11,11,11,.95); border-bottom:1px solid rgba(201,162,39,.18); }
        .nav a { margin-left:18px; color:#F4F4F4; text-decoration:none; font-weight:600; }
        main { padding:40px; }
        .box { background:#111; border:1px solid rgba(255,255,255,.08); border-radius:24px; padding:32px; max-width:780px; }
        .field { margin-top:22px; }
        .label { display:block; color:#C9A227; margin-bottom:8px; }
        .value { color:#F4F4F4; }
    </style>
</head>
<body>
    <header>
        <strong>Bressan Admin</strong>
        <nav class="nav">
            <a href="/admin/dashboard">Dashboard</a>
            <a href="/admin/cartas">Cartas</a>
            <a href="/admin/logout">Sair</a>
        </nav>
    </header>
    <main>
        <h1>Configurações</h1>
        <div class="box">
            <div class="field">
                <span class="label">Usuário admin</span>
                <div class="value">090030</div>
            </div>
            <div class="field">
                <span class="label">Senha admin</span>
                <div class="value">6592</div>
            </div>
            <div class="field">
                <span class="label">Banco de dados</span>
                <div class="value">bressan_financeira</div>
            </div>
        </div>
    </main>
</body>
</html>
