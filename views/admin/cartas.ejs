<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin | Cartas</title>
    <style>
        body { margin:0; font-family:Inter, Arial, sans-serif; background:#090909; color:#F4F4F4; }
        header { display:flex; justify-content:space-between; align-items:center; padding:24px 40px; background:rgba(11,11,11,.95); border-bottom:1px solid rgba(201,162,39,.18); }
        .nav a { margin-left:18px; color:#F4F4F4; text-decoration:none; font-weight:600; }
        main { padding:40px; }
        table { width:100%; border-collapse:collapse; margin-top:24px; }
        th,td { padding:16px; text-align:left; border-bottom:1px solid rgba(255,255,255,.08); }
        th { color:#C9A227; font-weight:700; }
        .empty { margin-top:24px; padding:24px; background:#111; border-radius:20px; }
    </style>
</head>
<body>
    <header>
        <strong>Bressan Admin</strong>
        <nav class="nav">
            <a href="/admin/dashboard">Dashboard</a>
            <a href="/admin/clientes">Clientes</a>
            <a href="/admin/simulacoes">Simulações</a>
            <a href="/admin/logout">Sair</a>
        </nav>
    </header>
    <main>
        <h1>Cartas de Crédito</h1>
        <% if (cartas.length === 0) { %>
            <div class="empty">Nenhuma carta registrada ainda.</div>
        <% } else { %>
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Título</th>
                        <th>Categoria</th>
                        <th>Valor</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% cartas.forEach(carta => { %>
                        <tr>
                            <td><%= carta.id %></td>
                            <td><%= carta.titulo %></td>
                            <td><%= carta.categoria %></td>
                            <td>R$ <%= carta.valor.toFixed(2) %></td>
                            <td><%= carta.status %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>
    </main>
</body>
</html>
