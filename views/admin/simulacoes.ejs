<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin | Simulações</title>
    <style>
        body { margin:0; font-family:Inter, Arial, sans-serif; background:#090909; color:#F4F4F4; }
        header { display:flex; justify-content:space-between; align-items:center; padding:24px 40px; background:rgba(11,11,11,.95); border-bottom:1px solid rgba(201,162,39,.18); }
        .nav a { margin-left:18px; color:#F4F4F4; text-decoration:none; font-weight:600; }
        main { padding:40px; }
        table { width:100%; border-collapse:collapse; margin-top:24px; }
        th,td { padding:16px; text-align:left; border-bottom:1px solid rgba(255,255,255,.08); }
        th { color:#C9A227; font-weight:700; }
        .empty { margin-top:24px; padding:24px; background:#111; border-radius:20px; }
    </style>
</head>
<body>
    <header>
        <strong>Bressan Admin</strong>
        <nav class="nav">
            <a href="/admin/dashboard">Dashboard</a>
            <a href="/admin/cartas">Cartas</a>
            <a href="/admin/reservas">Reservas</a>
            <a href="/admin/logout">Sair</a>
        </nav>
    </header>
    <main>
        <h1>Simulações</h1>
        <% if (simulacoes.length === 0) { %>
            <div class="empty">Nenhuma simulação cadastrada ainda.</div>
        <% } else { %>
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Nome</th>
                        <th>Email</th>
                        <th>Tipo</th>
                        <th>Valor</th>
                    </tr>
                </thead>
                <tbody>
                    <% simulacoes.forEach(simulacao => { %>
                        <tr>
                            <td><%= simulacao.id %></td>
                            <td><%= simulacao.nome %></td>
                            <td><%= simulacao.email %></td>
                            <td><%= simulacao.tipo %></td>
                            <td>R$ <%= simulacao.valor_solicitado.toFixed(2) %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>
    </main>
</body>
</html>
