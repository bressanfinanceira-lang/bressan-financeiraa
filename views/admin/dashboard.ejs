<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin | Dashboard</title>
    <style>
        body { margin:0; font-family: Inter, Arial, sans-serif; background:#090909; color:#F4F4F4; }
        header { display:flex; justify-content:space-between; align-items:center; padding:24px 40px; background:rgba(11,11,11,.95); border-bottom:1px solid rgba(201,162,39,.18); position:sticky; top:0; z-index:10; }
        .logo { display:flex; align-items:center; gap:12px; }
        .logo strong { color:#C9A227; letter-spacing:1px; }
        .nav { display:flex; gap:18px; }
        .nav a { color:#F4F4F4; text-decoration:none; font-weight:600; }
        .panel { padding:40px; }
        .stats { display:grid; grid-template-columns: repeat(4, minmax(200px,1fr)); gap:24px; margin-top:32px; }
        .card { background:#121212; border:1px solid rgba(255,255,255,.08); border-radius:24px; padding:24px; }
        .card h3 { margin:0 0 12px; color:#C9A227; }
        .detail { color:rgba(255,255,255,.8); }
        .info { margin-top:40px; display:grid; grid-template-columns:1fr 1fr; gap:24px; }
        .box { background:#111; border:1px solid rgba(255,255,255,.08); border-radius:24px; padding:24px; }
    </style>
</head>
<body>
    <header>
        <div>
            <strong>Bressan Admin</strong>
        </div>
        <nav class="nav">
            <a href="/admin/dashboard">Dashboard</a>
            <a href="/admin/cartas">Cartas</a>
            <a href="/admin/configuracoes">Configurações</a>
            <a href="/admin/logout">Sair</a>
        </nav>
    </header>
    <main class="panel">
        <h1>Visão Geral</h1>
        <div class="stats">
            <div class="card"><h3>Total de cartas</h3><p class="detail"><%= stats.totalCartas %></p></div>
            <div class="card"><h3>Cartas disponíveis</h3><p class="detail"><%= stats.disponiveis %></p></div>
            <div class="card"><h3>Cartas reservadas</h3><p class="detail"><%= stats.reservadas %></p></div>
            <div class="card"><h3>Cartas vendidas</h3><p class="detail"><%= stats.vendidas %></p></div>
            <div class="card"><h3>Simulações</h3><p class="detail"><%= stats.simulacoes %></p></div>
            <div class="card"><h3>Contatos</h3><p class="detail"><%= stats.contatos %></p></div>
            <div class="card"><h3>Último acesso</h3><p class="detail"><%= stats.lastAccess.toLocaleString('pt-BR') %></p></div>
        </div>
    </main>
</body>
</html>
